---
/**
 * Carrusel del equipo, replicando la sección "El equipo detrás de tu
 * proyecto" de tuappcode.com sobre los tokens de BioAltaris.
 *
 * Lo que se replica del original:
 *  - Tira horizontal con scroll-snap centrado y un solo card enfocado: el del
 *    centro va a escala 1 y nítido, los demás a 0.92, con blur y algo de
 *    transparencia.
 *  - Máscara de degradado en los bordes, para que los cards no se corten en
 *    seco contra el borde de la sección.
 *  - Avance automático de un card cada ~4.5 s, con arrastre del ratón y swipe
 *    táctil.
 *  - Ficha compacta: avatar circular, nombre, rol, separador, credenciales con
 *    icono y etiquetas tipo pill.
 *
 * Son exactamente los tres miembros del equipo, sin copias: el carrusel vuelve
 * al primero al llegar al último en vez de encadenar tandas repetidas.
 *
 * La biografía no cabe en una ficha de este tamaño, así que vive en el modal
 * que abre cada card (un <dialog> nativo, que ya trae cierre con Esc, captura
 * de foco y fondo inerte sin necesidad de librería).
 */
import { Image } from 'astro:assets';
import { EQUIPO } from '@constants/equipo';
---

<div class="team-fade relative mt-12">
   <ul class="team-swiper" data-team-swiper>
      {
         EQUIPO.map((miembro, i) => (
            <li class="team-card panel relative flex flex-col p-7" data-team-card>
               <span
                  class="team-avatar flex h-28 w-28 items-center justify-center overflow-hidden rounded-full border-2 border-accent/25 bg-accent/10 font-serif text-2xl font-semibold text-accent"
                  aria-hidden="true"
               >
                  {
                     miembro.foto ? (
                        <Image
                           src={miembro.foto}
                           alt=""
                           width={224}
                           height={224}
                           densities={[1, 2]}
                           loading="lazy"
                           class="h-full w-full object-cover"
                        />
                     ) : (
                        miembro.iniciales
                     )
                  }
               </span>

               <h3 class="mt-4 text-base font-semibold leading-snug">{miembro.nombre}</h3>
               <p class="mt-2 text-[13px] text-muted">{miembro.area}</p>

               <div class="my-4 h-px w-full bg-line" />

               <ul class="flex flex-col gap-2">
                  {miembro.credenciales.map((credencial) => (
                     <li class="flex items-start gap-2 text-[12px] leading-snug text-muted">
                        <svg
                           class="mt-px h-3.5 w-3.5 shrink-0 text-accent/60"
                           viewBox="0 0 24 24"
                           fill="none"
                           stroke="currentColor"
                           stroke-width="1.8"
                           stroke-linecap="round"
                           stroke-linejoin="round"
                           aria-hidden="true"
                           focusable="false"
                        >
                           <path d="M12 4 2 9l10 5 10-5zM6 11.5V17c0 1.5 2.7 3 6 3s6-1.5 6-3v-5.5" />
                        </svg>
                        <span>{credencial}</span>
                     </li>
                  ))}
               </ul>

               <ul class="mt-4 flex flex-wrap gap-1.5">
                  {miembro.etiquetas.map((etiqueta) => (
                     <li class="rounded-md border border-line px-2 py-[3px] text-[10px] uppercase tracking-wide text-muted">
                        {etiqueta}
                     </li>
                  ))}
               </ul>

               {/* El botón cubre la ficha entera: así todo el card es clicable
                   como en la referencia, pero sigue habiendo un control real
                   que se enfoca con el teclado y se anuncia como botón. */}
               <p class="team-vermas mt-5 text-[12px] font-semibold text-accent">Ver perfil →</p>
               <button
                  type="button"
                  class="absolute inset-0 rounded-2xl"
                  data-abrir-perfil={`miembro-${i}`}
                  aria-label={`Ver el perfil completo de ${miembro.nombre}`}
               />
            </li>
         ))
      }
   </ul>
</div>

{
   EQUIPO.map((miembro, i) => (
      <dialog class="team-modal" data-perfil={`miembro-${i}`} aria-labelledby={`perfil-${i}-nombre`}>
         <article class="relative rounded-2xl border border-line bg-bg2 p-7 text-left shadow-card sm:p-9">
            <button
               type="button"
               class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full border border-line text-muted transition hover:border-accent/50 hover:text-accent"
               data-cerrar-perfil
               aria-label="Cerrar"
            >
               <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  aria-hidden="true"
                  focusable="false"
               >
                  <path d="M6 6l12 12M18 6L6 18" />
               </svg>
            </button>

            <div class="flex items-center gap-4 pr-10">
               <span
                  class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full border-2 border-accent/25 bg-accent/10 font-serif text-xl font-semibold text-accent"
                  aria-hidden="true"
               >
                  {
                     miembro.foto ? (
                        <Image
                           src={miembro.foto}
                           alt=""
                           width={128}
                           height={128}
                           densities={[1, 2]}
                           loading="lazy"
                           class="h-full w-full object-cover"
                        />
                     ) : (
                        miembro.iniciales
                     )
                  }
               </span>
               <div>
                  <h2 id={`perfil-${i}-nombre`} class="text-xl leading-snug">
                     {miembro.nombre}
                  </h2>
                  <p class="mt-1 text-[11px] uppercase tracking-widest text-accent">{miembro.area}</p>
               </div>
            </div>

            <h3 class="mt-7 text-[11px] uppercase tracking-widest text-muted">Formación</h3>
            <ul class="mt-3 flex flex-col gap-2">
               {miembro.credenciales.map((credencial) => (
                  <li class="flex items-start gap-2 text-sm leading-relaxed">
                     <svg
                        class="mt-1 h-4 w-4 shrink-0 text-accent/70"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        focusable="false"
                     >
                        <path d="M12 4 2 9l10 5 10-5zM6 11.5V17c0 1.5 2.7 3 6 3s6-1.5 6-3v-5.5" />
                     </svg>
                     <span>{credencial}</span>
                  </li>
               ))}
            </ul>

            <h3 class="mt-7 text-[11px] uppercase tracking-widest text-muted">Trayectoria</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{miembro.bio}</p>

            <ul class="mt-7 flex flex-wrap gap-1.5">
               {miembro.etiquetas.map((etiqueta) => (
                  <li class="rounded-md border border-line px-2.5 py-1 text-[10px] uppercase tracking-wide text-muted">
                     {etiqueta}
                  </li>
               ))}
            </ul>
         </article>
      </dialog>
   ))
}

<style>
   /* Degradado en los bordes: los cards entran y salen desvanecidos en vez de
      cortarse contra el límite de la sección. */
   .team-fade {
      mask-image: linear-gradient(90deg, transparent 0, #000 40px, #000 calc(100% - 40px), transparent 100%);
   }

   @media (min-width: 768px) {
      .team-fade {
         mask-image: linear-gradient(90deg, transparent 0, #000 200px, #000 calc(100% - 200px), transparent 100%);
      }
   }

   .team-swiper {
      display: flex;
      gap: 14px;
      margin: 0;
      /* El padding lateral centra el primero y el último card, y deja aire
         arriba y abajo para que la sombra del activo no se recorte. */
      padding: 14px 9% 20px;
      list-style: none;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
      cursor: grab;
      overscroll-behavior-x: contain;
   }

   .team-swiper::-webkit-scrollbar {
      display: none;
   }

   .team-swiper[data-arrastrando] {
      cursor: grabbing;
      /* Durante el arrastre el snap pelearía con el scroll manual. */
      scroll-snap-type: none;
      scroll-behavior: auto;
   }

   .team-card {
      flex: 0 0 82%;
      min-width: 82%;
      scroll-snap-align: center;
      scroll-snap-stop: always;
      opacity: 0.85;
      transform: scale(0.94);
      transition:
         transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
         filter 0.35s ease,
         opacity 0.35s ease,
         box-shadow 0.35s ease;
   }

   @media (min-width: 768px) {
      .team-swiper {
         /* Media pantalla menos medio card. */
         padding-left: calc(50% - 160px);
         padding-right: calc(50% - 160px);
      }

      .team-card {
         flex: 0 0 320px;
         min-width: 320px;
         transform: scale(0.92);
         filter: blur(2px);
      }
   }

   .team-card.is-active {
      opacity: 1;
      transform: scale(1);
      filter: blur(0);
      box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.5);
      border-color: rgb(var(--accent) / 0.35);
   }

   html:not(.dark) .team-card.is-active {
      box-shadow:
         0 2px 8px rgb(12 21 38 / 0.04),
         0 14px 40px rgb(12 21 38 / 0.06);
   }

   .team-avatar {
      /* El avatar no debe encogerse cuando el nombre ocupa dos líneas. */
      flex: none;
   }

   /* El "Ver perfil" solo se enciende en el card enfocado; en los borrosos
      sería ruido, porque no es el que estás mirando. */
   .team-vermas {
      opacity: 0;
      transition: opacity 0.35s ease;
   }

   .team-card.is-active .team-vermas,
   .team-card:focus-within .team-vermas {
      opacity: 1;
   }

   /* El botón cubre el card entero, así que su propio aro de foco ya rodea la
      ficha; solo hay que redondearlo igual que ella (la regla global de
      :focus-visible lo deja en 2px). Va en el botón y no en el card con
      :focus-within a propósito: así el aro sale al tabular, pero no se queda
      pegado después de abrir el modal con un clic de ratón. */
   .team-card button:focus-visible {
      border-radius: 1rem;
   }

   /* ------------------------------------------------------------------ */
   /* Modal                                                               */
   /* ------------------------------------------------------------------ */

   /*
      Ojo con poner utilidades de display (flex, grid) en el propio <dialog>:
      sobreescriben el `display: none` que le da el navegador cuando está
      cerrado y el modal se quedaría visible siempre. El layout va dentro.
   */
   .team-modal {
      width: min(560px, calc(100vw - 2rem));
      max-height: calc(100svh - 3rem);
      padding: 0;
      border: 0;
      background: transparent;
      color: rgb(var(--text));
      overflow: visible;
   }

   .team-modal::backdrop {
      background: rgb(6 12 20 / 0.7);
      backdrop-filter: blur(4px);
   }

   .team-modal > article {
      max-height: calc(100svh - 3rem);
      overflow-y: auto;
   }

   .team-modal[open] {
      animation: teamModalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
   }

   .team-modal[open]::backdrop {
      animation: teamModalFondo 0.25s ease;
   }

   @keyframes teamModalIn {
      from {
         opacity: 0;
         transform: translateY(12px) scale(0.98);
      }
   }

   @keyframes teamModalFondo {
      from {
         opacity: 0;
      }
   }

   /* Sin animación: se apaga el desenfoque y el escalado, y la tira queda como
      un carrusel manual normal. */
   @media (prefers-reduced-motion: reduce) {
      .team-card {
         opacity: 1;
         transform: none;
         filter: none;
      }

      .team-vermas {
         opacity: 1;
      }
   }
</style>

<script>
   const AVANCE_MS = 4500;
   /** Píxeles arrastrados a partir de los cuales el gesto deja de ser un clic. */
   const UMBRAL_ARRASTRE = 6;

   const initCarrusel = (tira: HTMLElement) => {
      if (tira.dataset.iniciado === 'true') return;
      tira.dataset.iniciado = 'true';

      const cards = Array.from(tira.querySelectorAll<HTMLElement>('[data-team-card]'));
      if (!cards.length) return;

      /** Ancho de un card más el hueco: lo que mide un paso del carrusel. */
      const paso = () => (cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : cards[0].offsetWidth);

      /** Índice del card que está ahora en el centro. */
      const indiceActual = () => {
         const p = paso();
         return p ? Math.round(tira.scrollLeft / p) : 0;
      };

      const irA = (indice: number) => {
         const p = paso();
         if (p) tira.scrollTo({ left: indice * p, behavior: 'smooth' });
      };

      /** Marca como activo el card cuyo centro está más cerca del centro visible. */
      const marcarActivo = () => {
         const centro = tira.scrollLeft + tira.clientWidth / 2;
         let mejor = cards[0];
         let mejorDist = Infinity;

         for (const card of cards) {
            const dist = Math.abs(card.offsetLeft + card.offsetWidth / 2 - centro);
            if (dist < mejorDist) {
               mejorDist = dist;
               mejor = card;
            }
         }

         for (const card of cards) card.classList.toggle('is-active', card === mejor);
      };

      let pendiente = false;
      tira.addEventListener(
         'scroll',
         () => {
            if (pendiente) return;
            pendiente = true;
            requestAnimationFrame(() => {
               pendiente = false;
               marcarActivo();
            });
         },
         { passive: true },
      );

      // ---------------------------------------------------------------------
      // Arrastre con ratón. En táctil no se toca nada: el scroll nativo del
      // navegador ya hace el swipe, y sobrescribirlo sale peor.
      // ---------------------------------------------------------------------
      let arrastrando = false;
      let arrastreReal = false;
      let inicioX = 0;
      let inicioScroll = 0;

      tira.addEventListener('pointerdown', (e) => {
         if (e.pointerType === 'touch') return;
         arrastrando = true;
         arrastreReal = false;
         inicioX = e.clientX;
         inicioScroll = tira.scrollLeft;
      });

      tira.addEventListener('pointermove', (e) => {
         if (!arrastrando) return;

         const delta = e.clientX - inicioX;
         if (!arrastreReal) {
            if (Math.abs(delta) <= UMBRAL_ARRASTRE) return;

            // El puntero se captura AQUÍ y no en pointerdown: mientras hay
            // captura, el navegador redirige también el `click` al elemento
            // que captura, así que capturar desde el principio dejaba al botón
            // de cada ficha sin recibir nunca su clic. Al hacerlo solo cuando
            // el gesto ya es un arrastre, el clic simple llega intacto y el
            // arrastre sigue funcionando aunque el ratón salga de la tira.
            arrastreReal = true;
            tira.dataset.arrastrando = '';
            tira.setPointerCapture(e.pointerId);
         }

         e.preventDefault();
         tira.scrollLeft = inicioScroll - delta;
      });

      const soltar = (e: PointerEvent) => {
         if (!arrastrando) return;
         arrastrando = false;
         delete tira.dataset.arrastrando;
         if (tira.hasPointerCapture(e.pointerId)) tira.releasePointerCapture(e.pointerId);
         // Volver a pegar al card más cercano ahora que el snap está activo.
         irA(indiceActual());
      };

      tira.addEventListener('pointerup', soltar);
      tira.addEventListener('pointercancel', soltar);

      // Si el gesto fue un arrastre de verdad, no debe contar como clic sobre
      // el card (si no, soltar el ratón abriría el modal sin querer).
      tira.addEventListener(
         'click',
         (e) => {
            if (!arrastreReal) return;
            e.preventDefault();
            e.stopPropagation();
            arrastreReal = false;
         },
         true,
      );

      // ---------------------------------------------------------------------
      // Avance automático
      // ---------------------------------------------------------------------
      // Sin tandas repetidas: al llegar al último card vuelve al primero.
      const avanzar = () => irA((indiceActual() + 1) % cards.length);

      let intervalo = 0;
      let visible = false;
      let pausadoPorUsuario = false;
      const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const sincronizar = () => {
         const hayModalAbierto = document.querySelector('.team-modal[open]') !== null;
         const debeCorrer = visible && !document.hidden && !pausadoPorUsuario && !hayModalAbierto && !sinMovimiento;

         if (debeCorrer && !intervalo) {
            intervalo = window.setInterval(avanzar, AVANCE_MS);
         } else if (!debeCorrer && intervalo) {
            window.clearInterval(intervalo);
            intervalo = 0;
         }
      };

      // Mientras se lee un card, se arrastra o hay un modal abierto, el
      // carrusel no se mueve.
      tira.addEventListener('pointerenter', () => {
         pausadoPorUsuario = true;
         sincronizar();
      });
      tira.addEventListener('pointerleave', () => {
         pausadoPorUsuario = false;
         sincronizar();
      });

      // Al tabular hasta un card se centra, para no dejar el foco en uno
      // borroso y fuera de pantalla.
      tira.addEventListener('focusin', (e) => {
         pausadoPorUsuario = true;
         sincronizar();
         const card = (e.target as HTMLElement).closest<HTMLElement>('[data-team-card]');
         if (card) irA(cards.indexOf(card));
      });
      tira.addEventListener('focusout', () => {
         pausadoPorUsuario = false;
         sincronizar();
      });

      document.addEventListener('team-modal-cambio', sincronizar);

      new IntersectionObserver(
         ([entrada]) => {
            visible = entrada.isIntersecting;
            sincronizar();
         },
         { threshold: 0.2 },
      ).observe(tira);

      document.addEventListener('visibilitychange', sincronizar);

      // Al cambiar el ancho cambia el paso, así que hay que recolocar el
      // scroll sobre el card que estaba activo.
      let indiceAntesDeRedimensionar = 0;
      let redimensionar = 0;
      window.addEventListener(
         'resize',
         () => {
            if (!redimensionar) indiceAntesDeRedimensionar = indiceActual();
            window.clearTimeout(redimensionar);
            redimensionar = window.setTimeout(() => {
               redimensionar = 0;
               const previo = tira.style.scrollBehavior;
               tira.style.scrollBehavior = 'auto';
               tira.scrollLeft = indiceAntesDeRedimensionar * paso();
               tira.style.scrollBehavior = previo;
               marcarActivo();
            }, 150);
         },
         { passive: true },
      );

      marcarActivo();
   };

   // -------------------------------------------------------------------------
   // Modales de perfil
   // -------------------------------------------------------------------------
   const initModales = () => {
      const avisar = () => document.dispatchEvent(new CustomEvent('team-modal-cambio'));

      document.querySelectorAll<HTMLButtonElement>('[data-abrir-perfil]').forEach((boton) => {
         if (boton.dataset.iniciado === 'true') return;
         boton.dataset.iniciado = 'true';

         boton.addEventListener('click', () => {
            const id = boton.dataset.abrirPerfil;
            const modal = document.querySelector<HTMLDialogElement>(`[data-perfil="${id}"]`);
            if (!modal) return;

            // showModal() no existe en navegadores muy antiguos; ahí el
            // contenido no es un modal pero sigue siendo visible y legible.
            if (typeof modal.showModal === 'function') modal.showModal();
            else modal.setAttribute('open', '');

            avisar();
         });
      });

      document.querySelectorAll<HTMLDialogElement>('.team-modal').forEach((modal) => {
         if (modal.dataset.iniciado === 'true') return;
         modal.dataset.iniciado = 'true';

         modal.querySelector('[data-cerrar-perfil]')?.addEventListener('click', () => modal.close());

         // Clic en el fondo: el <article> ocupa toda la caja del diálogo, así
         // que si el evento cae en el propio <dialog> es que fue fuera.
         modal.addEventListener('click', (e) => {
            if (e.target === modal) modal.close();
         });

         // Cubre también el cierre con Esc, que el navegador hace por su cuenta.
         modal.addEventListener('close', avisar);
      });
   };

   const initTodo = () => {
      document.querySelectorAll<HTMLElement>('[data-team-swiper]').forEach(initCarrusel);
      initModales();
   };

   initTodo();
   document.addEventListener('astro:page-load', initTodo);
</script>
