---
import type { CollectionEntry } from 'astro:content';

interface Props {
   entrada: CollectionEntry<'conocimiento'>;
   delay?: number;
}

const { entrada, delay = 0 } = Astro.props;
const { titulo, resumen, fecha, fuente, categorias } = entrada.data;

const fechaISO = fecha.toISOString();
const fechaLegible = fecha.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' });
---

<article
   class="group relative flex h-full flex-col rounded-2xl border border-line bg-bg2/40 p-6 transition duration-300 hover:-translate-y-1 hover:border-accent/40"
   data-reveal
   data-reveal-delay={delay}
>
   <div class="flex flex-wrap items-center gap-2">
      <time datetime={fechaISO} class="font-serif text-sm text-accent">{fecha.getFullYear()}</time>
      {
         categorias.map((cat) => (
            <span class="rounded-full border border-line px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-widest text-muted">
               {cat}
            </span>
         ))
      }
   </div>

   <h3 class="mt-4 text-base font-semibold leading-snug">
      <a href={`/conocimiento/${entrada.id}`} class="after:absolute after:inset-0 after:content-['']">
         {titulo}
      </a>
   </h3>

   <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{resumen}</p>

   <footer class="mt-5 flex items-center justify-between gap-3 border-t border-line pt-4">
      {fuente && <span class="text-xs text-muted">{fuente}</span>}
      <span class="ml-auto text-xs text-muted">{fechaLegible}</span>
   </footer>
</article>
