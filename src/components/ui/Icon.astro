---
/**
 * Iconografía de servicios.
 *
 * Los mockups usaban emojis (🔬 🐁 🛡️ …). Se sustituyen por iconos de trazo
 * porque el emoji lo dibuja el sistema operativo: cambia de forma y de color
 * entre Windows, macOS y Android, no hereda el color de acento y en un
 * contexto regulatorio se lee como caricatura. Estos heredan `currentColor` y
 * escalan con la tipografía.
 */
import type { IconName } from '@constants/servicios';

interface Props {
   name: IconName;
   class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;

const paths: Record<IconName, string> = {
   // Microscopio — bioensayos celulares
   microscope: 'M6 18h12M8 18a5 5 0 0 1 4-8m2-6-4 2 3 6 4-2zM11 6l-1.5-3M15 14h3a4 4 0 0 1-4 4',
   // Roedor — modelos in vivo
   mouse: 'M10 12a5 5 0 1 1 8 3.5c-1 1-1.5 1.5-4 1.5H6a2 2 0 0 1 0-4zM16 8h.01M19 9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM6 17c-2 0-3 1-3 2',
   // Escudo — seguridad e inmunogenicidad
   shield: 'M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6zM9.5 11.5l1.8 1.8 3.4-3.4',
   // Barras — biodistribución
   chart: 'M4 20V10M9 20V4M14 20v-7M19 20v-11M3 20h18',
   // Matraz — evaluación farmacéutica
   flask: 'M9 3h6M10 3v6.5L5.2 17.4A2 2 0 0 0 6.9 20.5h10.2a2 2 0 0 0 1.7-3.1L14 9.5V3M7.5 14h9',
   // Reloj — estabilidad
   clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7.5V12l3 1.8',
   // Tendencia — análisis estadístico
   trending: 'M3 17l5.5-5.5 3.5 3.5L21 6M21 6h-5M21 6v5',
   // Idiomas — traducción técnica
   translate: 'M3 6h8M7 4v2c0 3.5-1.7 6.5-4 8M5.5 10c1 2.4 3 4.3 5.5 5M13 20l4-10 4 10M14.7 16.5h4.6',
   // Carpeta — dossier regulatorio
   folder: 'M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2.5h7A1.5 1.5 0 0 1 19 10v7.5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 3 17.5zM8 13h8',
   // Diana — evaluación TRL
   target: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 16.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9zM12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
   // Lupa — auditoría científica
   search: 'M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM16.2 16.2 21 21M8.5 11h5M11 8.5v5',
   // Pergamino — patentes
   scroll: 'M6 4h11a2 2 0 0 1 2 2v11M6 4a2 2 0 0 0-2 2v1.5h3M6 4v14a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-1H8M10 8.5h5M10 12h5',
};
---

<svg
   class={className}
   viewBox="0 0 24 24"
   fill="none"
   stroke="currentColor"
   stroke-width="1.5"
   stroke-linecap="round"
   stroke-linejoin="round"
   aria-hidden="true"
   focusable="false"
>
   <path d={paths[name]}></path>
</svg>
