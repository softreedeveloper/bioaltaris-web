---
/**
 * Fondo de constelación: partículas que se unen con una línea cuando están
 * cerca. Es el motivo visual del que sale el concepto de la marca (cada
 * servicio es un nodo conectado hacia un objetivo).
 *
 * Frente a la maqueta original se corrigen tres cosas que en producción
 * importan: se respeta `prefers-reduced-motion`, la animación se detiene
 * cuando el canvas sale del viewport o la pestaña pasa a segundo plano (si no,
 * consume batería durante toda la visita), y el número de partículas se
 * escala al ancho de pantalla en vez de ser 60 fijas también en un móvil.
 */
interface Props {
   class?: string;
}

const { class: className = '' } = Astro.props;
---

<canvas
   data-constellation
   class:list={['pointer-events-none absolute inset-0 h-full w-full', className]}
   aria-hidden="true"></canvas>

<script>
   const canvas = document.querySelector<HTMLCanvasElement>('[data-constellation]');
   const ctx = canvas?.getContext('2d');

   if (canvas && ctx && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const DISTANCIA_ENLACE = 150;

      interface Particula {
         x: number;
         y: number;
         vx: number;
         vy: number;
         r: number;
      }

      let particulas: Particula[] = [];
      let ancho = 0;
      let alto = 0;
      let frame = 0;
      let visible = false;

      /** Color de las partículas y las líneas, leído del tema activo. */
      const leerColores = () => {
         const estilos = getComputedStyle(document.documentElement);
         return {
            punto: estilos.getPropertyValue('--muted').trim(),
            linea: estilos.getPropertyValue('--accent').trim(),
         };
      };

      let colores = leerColores();

      const dimensionar = () => {
         // Se dibuja a la resolución real del dispositivo para que las líneas
         // de medio píxel no se vean borrosas en pantallas retina.
         const dpr = Math.min(window.devicePixelRatio || 1, 2);
         const rect = canvas.getBoundingClientRect();

         ancho = rect.width;
         alto = rect.height;
         canvas.width = Math.round(ancho * dpr);
         canvas.height = Math.round(alto * dpr);
         ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

         // Densidad constante por área, con tope: en un móvil salen ~25
         // partículas y en un monitor grande ~70, en vez de 60 siempre.
         const objetivo = Math.round(Math.min(Math.max((ancho * alto) / 22000, 20), 70));

         if (particulas.length > objetivo) {
            particulas.length = objetivo;
         } else {
            while (particulas.length < objetivo) {
               particulas.push({
                  x: Math.random() * ancho,
                  y: Math.random() * alto,
                  vx: (Math.random() - 0.5) * 0.5,
                  vy: (Math.random() - 0.5) * 0.5,
                  r: Math.random() * 1.5 + 0.5,
               });
            }
         }
      };

      const dibujar = () => {
         ctx.clearRect(0, 0, ancho, alto);

         for (const p of particulas) {
            p.x += p.vx;
            p.y += p.vy;

            // Rebote en los bordes
            if (p.x < 0 || p.x > ancho) p.vx *= -1;
            if (p.y < 0 || p.y > alto) p.vy *= -1;

            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fillStyle = `rgb(${colores.punto} / 0.5)`;
            ctx.fill();
         }

         ctx.lineWidth = 0.5;
         for (let i = 0; i < particulas.length; i++) {
            for (let j = i + 1; j < particulas.length; j++) {
               const dx = particulas[i].x - particulas[j].x;
               const dy = particulas[i].y - particulas[j].y;
               const dist = Math.hypot(dx, dy);
               if (dist >= DISTANCIA_ENLACE) continue;

               // La línea se desvanece con la distancia
               ctx.strokeStyle = `rgb(${colores.linea} / ${0.18 - dist / 1000})`;
               ctx.beginPath();
               ctx.moveTo(particulas[i].x, particulas[i].y);
               ctx.lineTo(particulas[j].x, particulas[j].y);
               ctx.stroke();
            }
         }

         frame = requestAnimationFrame(dibujar);
      };

      const arrancar = () => {
         if (frame) return;
         frame = requestAnimationFrame(dibujar);
      };

      const parar = () => {
         if (!frame) return;
         cancelAnimationFrame(frame);
         frame = 0;
      };

      const sincronizar = () => {
         visible && !document.hidden ? arrancar() : parar();
      };

      dimensionar();

      // Solo animar mientras el canvas está a la vista
      new IntersectionObserver(
         ([entry]) => {
            visible = entry.isIntersecting;
            sincronizar();
         },
         { threshold: 0 },
      ).observe(canvas);

      document.addEventListener('visibilitychange', sincronizar);

      let resizeTimer = 0;
      window.addEventListener(
         'resize',
         () => {
            window.clearTimeout(resizeTimer);
            resizeTimer = window.setTimeout(dimensionar, 150);
         },
         { passive: true },
      );

      // Al cambiar de tema hay que releer los colores o las partículas se
      // quedan con las del tema anterior hasta el próximo resize.
      new MutationObserver(() => {
         colores = leerColores();
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
   }
</script>
