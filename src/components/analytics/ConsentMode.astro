---
/**
 * Consent Mode v2. TIENE que ir en el head ANTES de GTM y GA4: el estado
 * `default` debe estar en el dataLayer cuando los tags se evalúan por primera
 * vez, o el primer page_view se envía sin restricciones.
 *
 * Se concede por defecto. El sitio ya no muestra banner de cookies, así que
 * no hay ninguna interacción que pueda pasar el estado de `denied` a
 * `granted`: arrancar denegado dejaría a GA4 y al Pixel sin medir nunca.
 *
 * Se conserva la capa de Consent Mode (en vez de quitarla) porque es lo que
 * GTM y GA4 esperan encontrar; si mañana se vuelve a exigir el aviso previo,
 * basta con cambiar `estado` a 'denied' y volver a montar un banner que llame
 * a `gtag('consent', 'update', ...)`.
 */
---

<script is:inline>
   (function () {
      window.dataLayer = window.dataLayer || [];
      function gtag() {
         window.dataLayer.push(arguments);
      }
      window.gtag = window.gtag || gtag;

      var estado = 'granted';

      gtag('consent', 'default', {
         ad_storage: estado,
         ad_user_data: estado,
         ad_personalization: estado,
         analytics_storage: estado,
         functionality_storage: 'granted',
         security_storage: 'granted',
      });
   })();
</script>
