---
import Logo from './Logo.astro';
import WhatsAppIcon from '@components/ui/WhatsAppIcon.astro';
import { NAV_LINKS, FOOTER_LEGAL } from '@constants/navegacion';
import { CATEGORIAS } from '@constants/servicios';
import { getSiteConfig } from '@utils/config';

const cfg = getSiteConfig(Astro.request);
const year = new Date().getFullYear();

// Los enlaces sociales del PPTX no traen URL. Mientras estén vacíos en la
// config, no se pinta el bloque: es mejor no tener redes que tener enlaces rotos.
const redes = [
   { nombre: 'LinkedIn', href: cfg.social.linkedin },
   { nombre: 'Instagram', href: cfg.social.instagram },
].filter((r) => r.href);
---

<footer class="mt-section border-t border-line bg-bg2/40">
   <div class="container-site py-12 lg:py-16">
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr]">
         <div>
            <Logo href={null} />
            <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted">
               Consultoría biofarmacéutica en desarrollo preclínico, validación analítica, control de calidad y
               regulación de productos biológicos.
            </p>

            <a
               href={`mailto:${cfg.contact.email}`}
               class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-accent transition hover:underline"
            >
               <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
               >
                  <path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                  <path d="m3.5 7.5 8.5 6 8.5-6"></path>
               </svg>
               {cfg.contact.email}
            </a>

            <a
               href={cfg.whatsappUrl}
               target="_blank"
               rel="noopener noreferrer"
               data-whatsapp="footer"
               class="mt-3 flex items-center gap-2 text-sm font-medium text-accent transition hover:underline"
            >
               <WhatsAppIcon class="h-4 w-4" />
               {cfg.contact.whatsappDisplay}
            </a>

            {
               redes.length > 0 && (
                  <ul class="mt-6 flex gap-4">
                     {redes.map((red) => (
                        <li>
                           <a
                              href={red.href}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-sm text-muted transition hover:text-accent"
                           >
                              {red.nombre}
                           </a>
                        </li>
                     ))}
                  </ul>
               )
            }
         </div>

         <nav aria-label="Navegación del pie">
            <h2 class="text-xs font-semibold uppercase tracking-eyebrow text-muted">Navegación</h2>
            <ul class="mt-4 flex flex-col gap-3">
               {
                  NAV_LINKS.map((link) => (
                     <li>
                        <a href={link.href} class="text-sm text-text/80 transition hover:text-accent">
                           {link.label}
                        </a>
                     </li>
                  ))
               }
            </ul>
         </nav>

         <nav aria-label="Servicios por etapa">
            <h2 class="text-xs font-semibold uppercase tracking-eyebrow text-muted">Servicios</h2>
            <ul class="mt-4 flex flex-col gap-3">
               {
                  CATEGORIAS.map((cat) => (
                     <li>
                        <a href={`/servicios#${cat.id}`} class="text-sm text-text/80 transition hover:text-accent">
                           {cat.nombre}
                        </a>
                     </li>
                  ))
               }
            </ul>
         </nav>
      </div>

      <div
         class="mt-12 flex flex-col gap-4 border-t border-line pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between"
      >
         <p>© {year} {cfg.site.name}. Todos los derechos reservados.</p>
         <ul class="flex gap-5">
            {
               FOOTER_LEGAL.map((link) => (
                  <li>
                     <a href={link.href} class="transition hover:text-accent">
                        {link.label}
                     </a>
                  </li>
               ))
            }
         </ul>
      </div>
   </div>
</footer>
