---
/**
 * Logotipo. Es tipográfico ("Bio" en peso fuerte + "Altaris" en el verde de
 * marca, ambos en serif), así que se compone con texto en vez de un PNG: pesa
 * cero bytes extra, escala sin pixelarse y cambia de tema solo.
 */
interface Props {
   class?: string;
   /** El logo del header es un enlace; el del footer, no. */
   href?: string | null;
}

const { class: className = '', href = '/' } = Astro.props;

const Tag = href ? 'a' : 'span';
---

<Tag
   {...href ? { href } : {}}
   class:list={['font-serif text-xl tracking-tight text-text sm:text-2xl', className]}
   aria-label="BioAltaris — Inicio"
>
   <span class="font-semibold">Bio</span><span class="text-accent">Altaris</span>
</Tag>
