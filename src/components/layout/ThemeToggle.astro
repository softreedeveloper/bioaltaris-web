---
/**
 * Interruptor de tema.
 *
 * El componente puede montarse varias veces (escritorio y menú móvil) pero el
 * listener es uno solo, delegado en `document`: así no importa cuántas
 * instancias haya ni si alguna se inserta después.
 */
interface Props {
   class?: string;
}

const { class: className = '' } = Astro.props;
---

<button
   type="button"
   data-theme-toggle
   aria-label="Cambiar entre tema claro y oscuro"
   class:list={[
      'flex h-11 w-11 items-center justify-center rounded-full text-muted transition hover:bg-text/5 hover:text-text',
      className,
   ]}
>
   <!-- Sol: visible en claro -->
   <svg
      class="block h-5 w-5 dark:hidden"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      aria-hidden="true"
   >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"
      ></path>
   </svg>
   <!-- Luna: visible en oscuro -->
   <svg
      class="hidden h-5 w-5 dark:block"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
   >
      <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path>
   </svg>
</button>

<script is:inline>
   (function () {
      if (window.__baThemeToggleBound) return;
      window.__baThemeToggleBound = true;

      document.addEventListener('click', function (e) {
         if (!e.target.closest('[data-theme-toggle]')) return;

         var isDark = document.documentElement.classList.toggle('dark');
         try {
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
         } catch (err) {
            /* sin persistencia, pero el cambio de esta sesión sí aplica */
         }

         window.dataLayer = window.dataLayer || [];
         window.dataLayer.push({ event: 'cambio_tema', theme: isDark ? 'dark' : 'light' });
      });
   })();
</script>
