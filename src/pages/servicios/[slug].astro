---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Icon from '@components/ui/Icon.astro';
import CtaSection from '@components/ui/CtaSection.astro';
import { SERVICIOS, getCategoria, serviciosPorCategoria } from '@constants/servicios';
import { generateServiceSchema, generateBreadcrumbSchema } from '@utils/schema';

export const prerender = true;

export function getStaticPaths() {
   return SERVICIOS.map((servicio) => ({
      params: { slug: servicio.slug },
      props: { servicio },
   }));
}

const { servicio } = Astro.props;
const categoria = getCategoria(servicio.categoria);
const relacionados = serviciosPorCategoria(servicio.categoria).filter((s) => s.slug !== servicio.slug);
const acento = servicio.acento === 'azul' ? 'text-accent2' : 'text-accent';

const schema = [
   generateServiceSchema(servicio, Astro.request),
   generateBreadcrumbSchema(
      [
         { name: 'Servicios', path: '/servicios' },
         { name: servicio.titulo, path: `/servicios/${servicio.slug}` },
      ],
      Astro.request,
   ),
];
---

<BaseLayout
   title={`${servicio.titulo} | Servicios BioAltaris`}
   description={servicio.resumen}
   type="article"
   schema={schema}
>
   <article>
      <header class="container-site pb-10 pt-10 lg:pt-14">
         <Breadcrumbs
            items={[
               { name: 'Servicios', href: '/servicios' },
               { name: servicio.titulo },
            ]}
         />

         <div class="mt-8 flex flex-wrap items-center gap-3">
            <span class:list={['flex h-12 w-12 items-center justify-center rounded-xl border border-line bg-bg2/60', acento]}>
               <Icon name={servicio.icono} class="h-6 w-6" />
            </span>
            <span
               class:list={[
                  'rounded-full border border-current/25 px-3 py-1 text-[10px] font-semibold uppercase tracking-widest',
                  acento,
               ]}
            >
               {servicio.tag}
            </span>
            <a
               href={`/servicios?etapa=${categoria.id}`}
               class="text-xs uppercase tracking-widest text-muted transition hover:text-accent"
            >
               {categoria.numero} · {categoria.nombre}
            </a>
         </div>

         <h1 class="mt-6 max-w-3xl text-4xl sm:text-5xl">{servicio.titulo}</h1>
         <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{servicio.resumen}</p>
      </header>

      <div class="container-site grid gap-10 pb-section lg:grid-cols-[1.4fr_1fr] lg:gap-16">
         <div>
            <h2 class="text-2xl">En qué consiste</h2>
            <p class="mt-4 text-base leading-relaxed text-muted">{servicio.detalle}</p>

            <h2 class="mt-12 text-2xl">Alcance</h2>
            <ul class="mt-5 flex flex-col gap-3">
               {
                  servicio.alcance.map((item) => (
                     <li class="flex gap-3 rounded-xl border border-line bg-bg2/40 p-4">
                        <svg
                           class:list={['mt-0.5 h-5 w-5 shrink-0', acento]}
                           viewBox="0 0 24 24"
                           fill="none"
                           stroke="currentColor"
                           stroke-width="1.8"
                           stroke-linecap="round"
                           stroke-linejoin="round"
                           aria-hidden="true"
                        >
                           <path d="m5 12.5 4.5 4.5L19 7.5" />
                        </svg>
                        <span class="text-sm leading-relaxed">{item}</span>
                     </li>
                  ))
               }
            </ul>

            <div class="mt-12 rounded-2xl border border-line bg-bg2/40 p-6">
               <p class="text-xs uppercase tracking-widest text-muted">Etapa {categoria.numero}</p>
               <h2 class="mt-2 text-xl">{categoria.nombre}</h2>
               <p class="mt-3 text-sm leading-relaxed text-muted">{categoria.descripcion}</p>
            </div>
         </div>

         <aside class="lg:sticky lg:top-28 lg:self-start">
            <div class="panel p-6">
               <h2 class="text-lg">¿Es lo que necesitas?</h2>
               <p class="mt-3 text-sm leading-relaxed text-muted">
                  Cuéntanos en qué punto está tu desarrollo y te decimos si este servicio resuelve tu pregunta o si
                  conviene otro antes.
               </p>
               <a
                  href="/contacto"
                  id={`cta-servicio-${servicio.slug}`}
                  data-cta="servicio_detalle"
                  class="btn-primary mt-6 w-full"
               >
                  Iniciar proyecto
               </a>
            </div>

            {
               relacionados.length > 0 && (
                  <nav class="mt-8" aria-label="Servicios de la misma etapa">
                     <h2 class="eyebrow">Misma etapa</h2>
                     <ul class="mt-4 flex flex-col gap-2">
                        {relacionados.map((otro) => (
                           <li>
                              <a
                                 href={`/servicios/${otro.slug}`}
                                 class="flex items-center justify-between gap-3 rounded-xl border border-line px-4 py-3 text-sm transition hover:border-accent/40 hover:text-accent"
                              >
                                 {otro.titulo}
                                 <span aria-hidden="true">→</span>
                              </a>
                           </li>
                        ))}
                     </ul>
                  </nav>
               )
            }
         </aside>
      </div>
   </article>

   <CtaSection location="servicio_final" />
</BaseLayout>

<script is:inline define:vars={{ slug: servicio.slug, titulo: servicio.titulo, categoria: categoria.nombre }}>
   window.dataLayer = window.dataLayer || [];
   window.dataLayer.push({
      event: 'view_service',
      service_slug: slug,
      service_name: titulo,
      service_category: categoria,
   });

   document.getElementById('cta-servicio-' + slug)?.addEventListener('click', () => {
      window.dataLayer.push({
         event: 'cta_iniciar_proyecto',
         cta_location: 'servicio_detalle',
         cta_label: titulo,
      });
      window.metaPixel?.track('Lead', { content_name: titulo, content_category: 'lead_generation' });
   });

   // Este script corre antes de que arranque el pixel (va inline en el punto
   // donde está el markup), así que el ViewContent se envía cuando el bootstrap
   // avisa que está listo.
   (function () {
      function enviar() {
         if (!window.metaPixel) return false;
         window.metaPixel.track('ViewContent', {
            content_name: titulo,
            content_ids: [slug],
            content_type: 'product',
            content_category: categoria,
         });
         return true;
      }
      if (!enviar()) document.addEventListener('metapixel:ready', () => setTimeout(enviar, 0), { once: true });
   })();
</script>
