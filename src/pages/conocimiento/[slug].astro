---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import CtaSection from '@components/ui/CtaSection.astro';
import { generateArticleSchema, generateBreadcrumbSchema } from '@utils/schema';

export const prerender = true;

export async function getStaticPaths() {
   const entradas = await getCollection('conocimiento', ({ data }) => !data.borrador);
   return entradas.map((entrada) => ({
      params: { slug: entrada.id },
      props: { entrada },
   }));
}

const { entrada } = Astro.props;
const { Content } = await render(entrada);
const { titulo, resumen, fecha, fuente, categorias } = entrada.data;

const path = `/conocimiento/${entrada.id}`;
const fechaISO = fecha.toISOString();
const fechaLegible = fecha.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' });

const schema = [
   generateArticleSchema(
      { title: titulo, description: resumen, path, publishedTime: fechaISO, tags: categorias },
      Astro.request,
   ),
   generateBreadcrumbSchema(
      [
         { name: 'Conocimiento', path: '/conocimiento' },
         { name: titulo, path },
      ],
      Astro.request,
   ),
];
---

<BaseLayout title={`${titulo} | BioAltaris`} description={resumen} type="article" publishedTime={fechaISO} schema={schema}>
   <article class="container-site pb-section pt-10 lg:pt-14">
      <Breadcrumbs items={[{ name: 'Conocimiento', href: '/conocimiento' }, { name: titulo }]} />

      <header class="mx-auto mt-8 max-w-3xl">
         <div class="flex flex-wrap items-center gap-2">
            <time datetime={fechaISO} class="text-xs text-muted">{fechaLegible}</time>
            {
               categorias.map((cat) => (
                  <span class="rounded-full border border-line px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-widest text-accent">
                     {cat}
                  </span>
               ))
            }
         </div>

         <h1 class="mt-5 text-3xl leading-tight sm:text-4xl">{titulo}</h1>
         <p class="mt-5 text-lg leading-relaxed text-muted">{resumen}</p>
         {fuente && <p class="mt-4 border-t border-line pt-4 text-xs text-muted">Fuente: {fuente}</p>}
      </header>

      <div class="prosa mx-auto mt-10 max-w-3xl">
         <Content />
      </div>

      <nav class="mx-auto mt-14 max-w-3xl border-t border-line pt-6">
         <a href="/conocimiento" class="text-sm font-semibold text-accent transition hover:underline">
            ← Volver a Conocimiento
         </a>
      </nav>
   </article>

   <CtaSection location="articulo_final" />
</BaseLayout>

<style is:global>
   /* Tipografía del cuerpo del artículo. Es el único sitio donde el HTML lo
      genera Markdown y no podemos poner clases en cada elemento. */
   .prosa > * + * {
      margin-top: 1.25rem;
   }

   .prosa h2 {
      margin-top: 2.5rem;
      font-size: 1.5rem;
   }

   .prosa h3 {
      margin-top: 2rem;
      font-size: 1.25rem;
   }

   .prosa p,
   .prosa li {
      color: rgb(var(--muted));
      line-height: 1.75;
   }

   .prosa ul,
   .prosa ol {
      padding-left: 1.25rem;
   }

   .prosa ul {
      list-style: disc;
   }

   .prosa ol {
      list-style: decimal;
   }

   .prosa li::marker {
      color: rgb(var(--accent));
   }

   .prosa a {
      color: rgb(var(--accent));
      text-decoration: underline;
   }

   .prosa blockquote {
      border-left: 2px solid rgb(var(--accent));
      padding-left: 1.25rem;
      font-style: italic;
   }
</style>
