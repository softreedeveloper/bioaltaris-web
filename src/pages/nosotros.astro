---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import CtaSection from '@components/ui/CtaSection.astro';
import TeamGrid from '@components/ui/TeamGrid.astro';
import { NOSOTROS_HERO, VALORES } from '@constants/equipo';
---

<BaseLayout>
   <section class="container-site pb-section pt-10 lg:pt-14">
      <Breadcrumbs />

      <header class="mt-6 max-w-3xl">
         <p class="eyebrow">Quiénes somos</p>
         <h1 class="mt-4 text-4xl sm:text-5xl">{NOSOTROS_HERO.titulo}</h1>
         <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">{NOSOTROS_HERO.descripcion}</p>
      </header>

      <dl class="mt-12 grid gap-8 sm:grid-cols-3 sm:gap-0" data-reveal>
         {
            VALORES.map((valor) => (
               <div class="border-l border-line pl-6 sm:pr-8">
                  <dt class="text-xl font-semibold">{valor.titulo}</dt>
                  <dd class="mt-2 text-sm leading-relaxed text-muted">{valor.descripcion}</dd>
               </div>
            ))
         }
      </dl>
   </section>

   <section class="container-site py-section" aria-labelledby="equipo">
      <header class="max-w-2xl" data-reveal>
         <p class="eyebrow">Nuestro equipo</p>
         <h2 id="equipo" class="mt-4 text-3xl sm:text-4xl">Las personas detrás de cada proyecto</h2>
      </header>

      <TeamGrid />
   </section>

   <CtaSection location="nosotros_final" />
</BaseLayout>
