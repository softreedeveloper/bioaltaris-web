---
/**
 * El recorrido de cuatro etapas hasta el expediente regulatorio. En móvil es
 * una línea a la izquierda con las tarjetas a la derecha; a partir de `lg` la
 * línea se centra y las tarjetas alternan lado.
 *
 * Las tarjetas solo llevan etiqueta y título: el detalle de cada servicio
 * vive en /servicios, no aquí.
 */
import Icon from '@components/ui/Icon.astro';
import { FASES, OBJETIVO_FINAL, IMPLEMENTACION } from '@constants/fases';
import { getServicio } from '@constants/servicios';

// Si un slug de fases.ts deja de existir en servicios.ts, el build falla aquí
// en vez de publicar un enlace roto.
for (const fase of FASES) {
   for (const nodo of fase.nodos) {
      if (nodo.slug && !getServicio(nodo.slug)) {
         throw new Error(`fases.ts referencia un servicio inexistente: ${nodo.slug}`);
      }
   }
}

const acentoDe = (acento: 'verde' | 'azul') => (acento === 'azul' ? 'text-accent2' : 'text-accent');
---

<section class="ruta relative py-section" aria-labelledby="ruta-titulo">
   <div class="container-site">
      <header class="mx-auto max-w-2xl text-center" data-reveal>
         <p class="eyebrow">Cómo te acompañamos</p>
         <h2 id="ruta-titulo" class="mt-4 text-3xl sm:text-4xl">Nuestro acompañamiento abarca</h2>
         <p class="mt-4 text-base leading-relaxed text-muted">
            Cuatro etapas del desarrollo de tu producto. Puedes trabajar con nosotros en todas o solo en la que
            necesites.
         </p>
      </header>

      <div class="ruta-track relative mt-16">
         <div class="ruta-linea" aria-hidden="true"></div>
         <div class="ruta-progreso" id="rutaProgreso" aria-hidden="true"></div>

         {
            FASES.map((fase) => (
               <div class="ruta-fase">
                  <div class="ruta-fase-cabecera" data-reveal>
                     <span class:list={['ruta-orbe', acentoDe(fase.acento)]} aria-hidden="true">
                        {fase.numero}
                     </span>
                     {/* Título y lema llevan fondo para que la línea del rail no
                         atraviese las letras. */}
                     <h3 class="ruta-fase-titulo mt-4 text-xl uppercase tracking-[0.15em] sm:text-2xl">
                        {fase.titulo}
                     </h3>
                     <p class:list={['ruta-fase-lema mt-2 text-xs uppercase tracking-widest', acentoDe(fase.acento)]}>
                        {fase.lema}
                     </p>
                  </div>

                  {fase.nodos.map((nodo, i) => (
                     <div class="ruta-fila" data-lado={i % 2 === 0 ? 'izq' : 'der'}>
                        <span class:list={['ruta-nodo', acentoDe(nodo.acento)]} aria-hidden="true" />

                        <article class="ruta-tarjeta panel px-5 py-4" data-reveal>
                           <div class:list={['ruta-tarjeta-meta flex items-center gap-2', acentoDe(nodo.acento)]}>
                              <Icon name={nodo.icono} class="h-4 w-4" />
                              <span class="text-[10px] font-semibold uppercase tracking-widest">{nodo.tag}</span>
                           </div>

                           <h4 class="mt-1.5 text-lg font-semibold">
                              {nodo.slug ? (
                                 <a href={`/servicios/${nodo.slug}`} class="transition hover:text-accent">
                                    {nodo.titulo}
                                 </a>
                              ) : (
                                 nodo.titulo
                              )}
                           </h4>
                        </article>
                     </div>
                  ))}
               </div>
            ))
         }

         <div class="ruta-objetivo" id="rutaObjetivo" data-reveal>
            <span class="ruta-objetivo-icono" aria-hidden="true">
               <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-8 w-8"
               >
                  <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path>
                  <path d="M14 3v5h5M9 13h6M9 17h6"></path>
               </svg>
            </span>

            <h3 class="mt-6 text-2xl sm:text-3xl">
               <span class="gradient-text">{OBJETIVO_FINAL.titulo}</span>
            </h3>
            <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-muted sm:text-base">
               {OBJETIVO_FINAL.descripcion}
            </p>
         </div>
      </div>

      <div
         class="mt-16 flex flex-col gap-6 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between"
         data-reveal
      >
         <p class="max-w-xl text-sm leading-relaxed text-muted">
            <strong class="font-semibold text-text">{IMPLEMENTACION.titulo}</strong>
            {IMPLEMENTACION.descripcion}
         </p>
         <a href="/servicios" class="btn-ghost shrink-0">
            {IMPLEMENTACION.cta}
            <span aria-hidden="true">→</span>
         </a>
      </div>
   </div>
</section>

<style>
   /* --- Rail: a la izquierda en móvil, centrado desde lg --- */
   .ruta-track {
      --rail: 1.25rem;
   }

   .ruta-linea,
   .ruta-progreso {
      position: absolute;
      top: 0;
      bottom: 0;
      left: var(--rail);
      width: 1px;
   }

   .ruta-linea {
      background: rgb(var(--line));
   }

   .ruta-progreso {
      bottom: auto;
      height: 0;
      background: linear-gradient(180deg, rgb(var(--accent)), rgb(var(--accent-2)));
      box-shadow: 0 0 8px rgb(var(--accent) / 0.4);
      transition: height 0.4s ease-out;
   }

   .ruta-fase + .ruta-fase {
      margin-top: 4rem;
   }

   .ruta-fase-cabecera {
      position: relative;
      z-index: 1;
      padding-left: calc(var(--rail) + 2.5rem);
   }

   .ruta-orbe {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 3rem;
      height: 3rem;
      border-radius: 999px;
      border: 1px solid currentColor;
      background: rgb(var(--bg));
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      font-size: 1.125rem;
      box-shadow: 0 0 20px rgb(var(--accent) / 0.25);
      /* Centra el orbe sobre el rail */
      margin-left: calc(-1 * (var(--rail) + 2.5rem) + var(--rail) - 1.5rem);
   }

   .ruta-fila {
      position: relative;
      margin-top: 1.25rem;
      padding-left: calc(var(--rail) + 2.5rem);
   }

   .ruta-nodo {
      position: absolute;
      top: 50%;
      left: var(--rail);
      width: 0.75rem;
      height: 0.75rem;
      margin-top: -0.375rem;
      margin-left: -0.375rem;
      border-radius: 999px;
      background: currentColor;
      box-shadow: 0 0 10px currentColor;
   }

   /* Conector del nodo a la tarjeta */
   .ruta-nodo::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 100%;
      width: 2rem;
      height: 1px;
      background: currentColor;
      opacity: 0.4;
   }

   .ruta-objetivo {
      margin-top: 5rem;
      padding-left: calc(var(--rail) + 2.5rem);
   }

   .ruta-objetivo-icono {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 5rem;
      height: 5rem;
      border-radius: 999px;
      color: rgb(var(--accent));
      background: linear-gradient(135deg, rgb(var(--accent) / 0.2), rgb(var(--accent-2) / 0.2));
      box-shadow: 0 0 40px rgb(var(--accent) / 0.3);
      margin-left: calc(-1 * (var(--rail) + 2.5rem) + var(--rail) - 2.5rem);
   }

   .ruta-objetivo-icono::before {
      content: '';
      position: absolute;
      inset: -0.625rem;
      border-radius: 999px;
      border: 1px dashed rgb(var(--accent-2) / 0.5);
      animation: theme('animation.spinSlow');
   }

   @media (min-width: 1024px) {
      .ruta-track {
         --rail: 50%;
      }

      .ruta-fase-cabecera {
         padding-left: 0;
         text-align: center;
      }

      /* Con el rail centrado, la línea pasaría por detrás del título de la
         fase. El fondo opaco sobre el propio texto la oculta justo ahí. */
      .ruta-fase-titulo,
      .ruta-fase-lema {
         width: fit-content;
         margin-inline: auto;
         padding-inline: 1rem;
         background: rgb(var(--bg));
      }

      .ruta-orbe {
         margin-left: 0;
      }

      .ruta-fila {
         display: grid;
         grid-template-columns: 1fr 1fr;
         column-gap: 4rem;
         padding-left: 0;
         margin-top: 1.25rem;
      }

      .ruta-fila[data-lado='izq'] .ruta-tarjeta {
         grid-column: 1;
         justify-self: end;
         text-align: right;
      }

      .ruta-fila[data-lado='der'] .ruta-tarjeta {
         grid-column: 2;
         justify-self: start;
      }

      .ruta-fila[data-lado='izq'] .ruta-nodo::after {
         left: auto;
         right: 100%;
      }

      /* En la columna izquierda la fila de icono + etiqueta se alinea a la
         derecha, igual que el título. */
      .ruta-fila[data-lado='izq'] .ruta-tarjeta-meta {
         flex-direction: row-reverse;
      }

      .ruta-objetivo {
         padding-left: 0;
         text-align: center;
      }

      .ruta-objetivo-icono {
         margin-left: 0;
      }
   }
</style>

<script>
   /**
    * La línea de progreso se rellena conforme el usuario avanza por el
    * recorrido. Se calcula contra la posición del objetivo final, no contra el
    * alto del documento, para que llegue al 100% justo al alcanzarlo.
    */
   const track = document.querySelector<HTMLElement>('.ruta-track');
   const progreso = document.getElementById('rutaProgreso');
   const objetivo = document.getElementById('rutaObjetivo');

   if (track && progreso && objetivo && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let pendiente = false;

      const actualizar = () => {
         pendiente = false;

         const rectTrack = track.getBoundingClientRect();
         const rectObjetivo = objetivo.getBoundingClientRect();

         const inicio = rectTrack.top;
         const fin = rectObjetivo.top + rectObjetivo.height / 2 - rectTrack.top;
         if (fin <= 0) return;

         // Punto de referencia: dos tercios de la altura de la ventana
         const recorrido = window.innerHeight / 1.5 - inicio;
         const porcentaje = Math.min(Math.max((recorrido / fin) * 100, 0), 100);

         progreso.style.height = `${porcentaje}%`;
      };

      const onScroll = () => {
         if (pendiente) return;
         pendiente = true;
         requestAnimationFrame(actualizar);
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      actualizar();
   }
</script>
