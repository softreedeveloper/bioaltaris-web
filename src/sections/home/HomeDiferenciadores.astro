---
import { DIFERENCIADORES } from '@constants/equipo';
---

<section class="container-site py-section" aria-labelledby="por-que-elegirnos">
   <header class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow">Por qué elegirnos</p>
      <h2 id="por-que-elegirnos" class="mt-4 text-3xl sm:text-4xl">Un equipo, no un proveedor</h2>
   </header>

   <div class="mt-14 grid gap-10 md:grid-cols-3 md:gap-12">
      {
         DIFERENCIADORES.map((item, i) => (
            <article class="border-t border-line pt-7" data-reveal data-reveal-delay={i * 100}>
               {/* Trazo corto de acento sobre la línea, alternando los dos colores de marca. */}
               <span
                  class:list={['-mt-7 block h-px w-11', i % 2 === 0 ? 'bg-accent' : 'bg-accent2']}
                  aria-hidden="true"
               />
               <span
                  class:list={[
                     'mt-7 block text-xs font-semibold tracking-eyebrow',
                     i % 2 === 0 ? 'text-accent' : 'text-accent2',
                  ]}
               >
                  0{i + 1}
               </span>
               <h3 class="mt-2 text-xl font-semibold">{item.titulo}</h3>
               <p class="mt-3 text-sm leading-relaxed text-muted">{item.descripcion}</p>
            </article>
         ))
      }
   </div>
</section>
