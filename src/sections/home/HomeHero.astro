---
import ConstellationCanvas from '@components/decorative/ConstellationCanvas.astro';
import { CTA_PRINCIPAL } from '@constants/navegacion';
import { SERVICIOS, CATEGORIAS } from '@constants/servicios';
---

<section class="relative overflow-hidden">
   <ConstellationCanvas class="opacity-60" />

   <div class="container-site relative py-20 text-center sm:py-28 lg:py-36">
      <p class="eyebrow">Consultoría biofarmacéutica</p>

      <h1 class="mx-auto mt-5 max-w-3xl text-[clamp(2.25rem,6vw,3.75rem)] font-normal">
         La constelación de tu <span class="gradient-text">éxito regulatorio</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
         Cada servicio es un nodo crítico conectado hacia un único objetivo: llevar tu desarrollo biológico desde el
         laboratorio hasta un activo protegido y validado.
      </p>

      <div class="mt-9 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
         <a href={CTA_PRINCIPAL.href} id="cta-home-hero" data-cta="home_hero" class="btn-primary">
            {CTA_PRINCIPAL.label}
         </a>
         <a href="/servicios" class="btn-ghost">Ver servicios</a>
      </div>

      <dl
         class="mx-auto mt-14 grid max-w-lg grid-cols-3 gap-4 border-t border-line pt-8 text-center sm:mt-16 sm:gap-8"
      >
         <div>
            <dt class="sr-only">Servicios</dt>
            <dd class="font-serif text-2xl text-accent sm:text-3xl">{SERVICIOS.length}</dd>
            <p class="mt-1 text-[11px] uppercase tracking-widest text-muted">Servicios</p>
         </div>
         <div>
            <dt class="sr-only">Etapas</dt>
            <dd class="font-serif text-2xl text-accent sm:text-3xl">{CATEGORIAS.length}</dd>
            <p class="mt-1 text-[11px] uppercase tracking-widest text-muted">Etapas</p>
         </div>
         <div>
            <dt class="sr-only">Idiomas de entrega</dt>
            <dd class="font-serif text-2xl text-accent sm:text-3xl">ES/EN</dd>
            <p class="mt-1 text-[11px] uppercase tracking-widest text-muted">Entrega</p>
         </div>
      </dl>
   </div>
</section>

<script>
   import { trackCta, trackMeta } from '@utils/analytics';

   document.getElementById('cta-home-hero')?.addEventListener('click', () => {
      trackCta('home_hero', 'Iniciar proyecto');
      trackMeta('Lead', { content_name: 'CTA hero', content_category: 'lead_generation' });
   });
</script>
